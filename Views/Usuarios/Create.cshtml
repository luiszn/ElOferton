@model CrearUsuarioViewModel
@{
    ViewData["Title"] = "Nuevo usuario";
}

<div class="page-heading">
    <div>
        <h1>Nuevo usuario</h1>
        <p>El usuario se crea con contraseña y se asigna a un rol y ambiente.</p>
    </div>
    <a asp-action="Index" class="btn btn-light"><i class="bi bi-arrow-left"></i> Volver</a>
</div>

<div class="card-eo" style="max-width: 800px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="NombreCompleto" class="form-label fw-semibold"></label>
                    <input asp-for="NombreCompleto" class="form-control" />
                    <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="UserName" class="form-label fw-semibold"></label>
                    <input asp-for="UserName" class="form-control" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <input asp-for="Password" class="form-control" type="password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Rol" class="form-label fw-semibold"></label>
                    <select asp-for="Rol" asp-items="Model.Roles" class="form-select"><option value="">Seleccione</option></select>
                    <span asp-validation-for="Rol" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PuntoVentaId" class="form-label fw-semibold"></label>
                    <select asp-for="PuntoVentaId" asp-items="Model.PuntosVenta" class="form-select"><option value="">Sin ambiente</option></select>
                    <span asp-validation-for="PuntoVentaId" class="text-danger"></span>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-eo"><i class="bi bi-person-plus"></i> Crear usuario</button>
                <a asp-action="Index" class="btn btn-light">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
