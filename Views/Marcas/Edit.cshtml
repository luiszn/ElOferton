@model CatalogoFormViewModel
@{
    ViewData["Title"] = "Editar marca";
}

<div class="page-heading">
    <div><h1>Editar marca</h1><p>Actualice los datos de la marca.</p></div>
    <a asp-action="Index" class="btn btn-light"><i class="bi bi-arrow-left"></i> Volver</a>
</div>

<div class="card-eo" style="max-width: 700px;">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input asp-for="Id" type="hidden" />
            <partial name="_CatalogoForm" model="Model" />
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-eo"><i class="bi bi-save"></i> Guardar cambios</button>
                <a asp-action="Index" class="btn btn-light">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
