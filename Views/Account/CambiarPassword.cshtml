@model CambiarPasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="page-heading">
    <div>
        <h1>Cambiar contraseña</h1>
        <p>Use una contraseña segura y no compártala con otros usuarios.</p>
    </div>
</div>

<div class="card-eo" style="max-width: 620px;">
    <div class="card-body">
        <form asp-action="CambiarPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Actual" class="form-label fw-semibold"></label>
                <input asp-for="Actual" class="form-control" />
                <span asp-validation-for="Actual" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Nueva" class="form-label fw-semibold"></label>
                <input asp-for="Nueva" class="form-control" />
                <span asp-validation-for="Nueva" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Confirmar" class="form-label fw-semibold"></label>
                <input asp-for="Confirmar" class="form-control" />
                <span asp-validation-for="Confirmar" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-eo">Actualizar contraseña</button>
            <a asp-action="Perfil" class="btn btn-light ms-2">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
