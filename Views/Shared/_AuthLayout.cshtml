<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EL OFERTÓN</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-wrapper">
        <div class="auth-brand">
            <div class="brand-mark brand-mark-lg"><i class="bi bi-stars"></i></div>
            <h1>EL OFERTÓN</h1>
            <p>Cosmética, belleza y cuidado personal</p>
            <span><i class="bi bi-geo-alt-fill"></i> Cajamarca, Perú</span>
        </div>
        <div class="auth-card card shadow-lg border-0">
            <div class="card-body p-4 p-md-5">
                @RenderBody()
            </div>
        </div>
        <p class="auth-footer">Sistema interno de gestión · Uso autorizado</p>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
