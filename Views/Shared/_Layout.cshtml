<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EL OFERTÓN</title>
    @functions {
        private string Activo(string controlador, params string[] acciones)
        {
            var controller = ViewContext.RouteData.Values["controller"]?.ToString();
            var action = ViewContext.RouteData.Values["action"]?.ToString();
            var mismoControlador = string.Equals(controller, controlador, StringComparison.OrdinalIgnoreCase);
            var mismaAccion = acciones.Length == 0 || acciones.Any(a => string.Equals(a, action, StringComparison.OrdinalIgnoreCase));
            return mismoControlador && mismaAccion ? "active" : string.Empty;
        }
    }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ElOferton.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <div class="brand">
                <div class="brand-mark"><i class="bi bi-stars"></i></div>
                <div>
                    <strong>EL OFERTÓN</strong>
                    <small>Cosmética y belleza · Cajamarca</small>
                </div>
            </div>

            <nav class="sidebar-nav">
                <span class="nav-section">OPERACIÓN</span>
                    <a class="nav-link @(Activo("Home", "Index"))" asp-controller="Home" asp-action="Index">

                    <i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
                </a>

                @if (User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Vendedor))
                {
                    <a class="nav-link @(Activo("Ventas", "Index"))" asp-controller="Ventas" asp-action="Index">
                        <i class="bi bi-cart-plus-fill"></i><span>Punto de venta</span>
                    </a>
                    <a class="nav-link @(Activo("Ventas", "Historial", "Detalle", "Reimprimir", "Comprobante"))" asp-controller="Ventas" asp-action="Historial">
                        <i class="bi bi-receipt"></i><span>Historial de ventas</span>
                    </a>
                    <a class="nav-link @(Activo("Clientes"))" asp-controller="Clientes" asp-action="Index">
                        <i class="bi bi-people-fill"></i><span>Clientes</span>
                    </a>
                }

                <span class="nav-section">CATÁLOGO E INVENTARIO</span>
                <a class="nav-link @(Activo("Productos"))" asp-controller="Productos" asp-action="Index">
                    <i class="bi bi-box-seam-fill"></i><span>Productos</span>
                </a>
                @if (User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Almacenero))
                {
                    <a class="nav-link @(Activo("Categorias"))" asp-controller="Categorias" asp-action="Index">
                        <i class="bi bi-tags-fill"></i><span>Categorías</span>
                    </a>
                    <a class="nav-link @(Activo("Marcas"))" asp-controller="Marcas" asp-action="Index">
                        <i class="bi bi-award-fill"></i><span>Marcas</span>
                    </a>
                    <a class="nav-link @(Activo("Inventario", "Existencias"))" asp-controller="Inventario" asp-action="Existencias">
                        <i class="bi bi-clipboard-data-fill"></i><span>Existencias</span>
                    </a>
                    <a class="nav-link @(Activo("Inventario", "Movimientos", "NuevoMovimiento"))" asp-controller="Inventario" asp-action="Movimientos">
                        <i class="bi bi-arrow-left-right"></i><span>Movimientos</span>
                    </a>
                }

                <span class="nav-section">ANÁLISIS</span>
                <a class="nav-link @(Activo("Reportes"))" asp-controller="Reportes" asp-action="Index">
                    <i class="bi bi-bar-chart-line-fill"></i><span>Reportes</span>
                </a>

                @if (User.IsInRole(Roles.Administrador))
                {
                    <span class="nav-section">SEGURIDAD</span>
                    <a class="nav-link @(Activo("Usuarios"))" asp-controller="Usuarios" asp-action="Index">
                        <i class="bi bi-person-gear"></i><span>Usuarios</span>
                    </a>
                }
            </nav>

            <div class="sidebar-footer">
                <i class="bi bi-shield-check"></i>
                <span>Uso interno · Red EL OFERTÓN</span>
            </div>
        </aside>

        <div class="main-wrap">
            <header class="topbar">
                <button class="btn btn-light sidebar-toggle" type="button" id="sidebarToggle" aria-label="Alternar menú">
                    <i class="bi bi-list"></i>
                </button>
                <div class="topbar-title">
                    <span class="topbar-subtitle">EL OFERTÓN</span>
                    <strong>@ViewData["Title"]</strong>
                </div>
                <div class="topbar-actions ms-auto">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <button class="btn btn-user dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i>
                                <span>@(User.FindFirst("NombreCompleto")?.Value ?? User.Identity.Name)</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="Perfil">
                                        <i class="bi bi-person-badge"></i> Mi perfil
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="CambiarPassword">
                                        <i class="bi bi-key"></i> Cambiar contraseña
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </header>

            <main class="content">
                @if (TempData["Mensaje"] is string mensaje)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill"></i> @mensaje
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                    </div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i> @error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
